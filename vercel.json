{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/v1/cron/night-audit",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/automations",
      "schedule": "*/15 * * * *"
    }
  ]
}
