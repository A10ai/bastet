# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret (Settings > API). Optional: enables local token verification; projects on asymmetric keys use the JWKS automatically.
SUPABASE_JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (Claude API) — optional, transitioning to local LLM
ANTHROPIC_API_KEY=
# Optional: Claude model for the AI brain and chat (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# OpenAI (for AI concierge) — optional
OPENAI_API_KEY=

# Email
RESEND_API_KEY=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# FX Rates
OPEN_EXCHANGE_RATES_APP_ID=

# Wi-Fi credentials for messaging templates
WIFI_SSID=
WIFI_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROPERTY_ID=
# Security (see README > Security configuration)
PII_ENCRYPTION_KEY=
# During key rotation only: the key being retired. Reads fall back to it; POST /api/v1/admin/encrypt-pii re-encrypts.
PII_ENCRYPTION_KEY_PREVIOUS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=owner,admin
AUTO_PRICING_ENABLED=false
SENTRY_DSN=
