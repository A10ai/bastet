# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret (Settings > API). Optional: enables local token verification; projects on asymmetric keys use the JWKS automatically.
SUPABASE_JWT_SECRET=

# Stripe — online booking deposits (docs/ONLINE-BOOKING.md). Without a secret
# key the public booking flow falls back to "request to book" (staff confirm).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the endpoint https://<app>/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Anthropic (Claude API) — optional, transitioning to local LLM
ANTHROPIC_API_KEY=
# Optional: Claude model for the AI brain and chat (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Booking concierge (docs/CONCIERGE.md): uses ANTHROPIC_API_KEY; model override optional
CONCIERGE_MODEL=
# WhatsApp Business (Meta Cloud API) — optional
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OpenAI — unused, kept for compatibility
OPENAI_API_KEY=

# Email
RESEND_API_KEY=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# FX Rates
OPEN_EXCHANGE_RATES_APP_ID=

# Wi-Fi credentials for messaging templates
WIFI_SSID=
WIFI_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROPERTY_ID=
# Shown when the properties table cannot be read (fallback only)
NEXT_PUBLIC_PROPERTY_NAME=
# Security (see README > Security configuration)
PII_ENCRYPTION_KEY=
# During key rotation only: the key being retired. Reads fall back to it; POST /api/v1/admin/encrypt-pii re-encrypts.
PII_ENCRYPTION_KEY_PREVIOUS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Bearer token for /api/v1/cron/* (Vercel Cron and the GitHub Actions scheduler)
CRON_SECRET=
# Self-hosted only: set true when a reverse proxy in front overwrites X-Forwarded-For/X-Real-IP.
# Without it (and off Vercel) client IP headers are ignored for rate limiting.
TRUST_PROXY_HEADERS=
# Optional: expected JWT issuer when it is not <NEXT_PUBLIC_SUPABASE_URL>/auth/v1 on *.supabase.co
SUPABASE_JWT_ISSUER=
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=owner,admin
AUTO_PRICING_ENABLED=false
SENTRY_DSN=
